__pycache__/
tmp/
build/
*.egg-info/

# The holdout in the clear, in every round.
# Only the ciphertext bundle and the ledger belong in history;
# a committed sample or a committed labeling pass would end that round permanently,
# because git keeps what a later commit deletes.
# The patterns match any round directory, so a new round is covered before it is drawn
# rather than by whoever remembers to add three lines here.
tests/corpus/holdout/*/sample.json
tests/corpus/holdout/*/adjudications.json
tests/corpus/holdout/*/labels/

# The repair batches, which are derived rather than evidence.
# A batch is reproducible byte for byte from the sample and two files in this tree,
# and a test asserts exactly that,
# so committing three copies of the same prose buys nothing history does not already hold.
# The sample and the answers are evidence and are committed.
tests/corpus/repairs/batches/

# Pinned upstream sources the corpus draws from, materialized by commit from manifest.json.
# Reconstructible, large, and not ours to vendor.
tests/corpus/checkouts/
